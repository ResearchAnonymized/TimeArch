# TimeArch — example environment file for the ECSA 2026 AE bundle.
# Copy to .env (the real .env is git-ignored) and fill in only what you need.
#
# ─── Reviewer / replay-mode reproduction (no secrets required) ────────────
# Default. Edge functions read responses from reproducibility/llm-cassette.json.
LLM_MODE=replay
LLM_CASSETTE_PATH=./reproducibility/llm-cassette.json

# ─── Optional: live mode (only if you want to re-run agents against an LLM)
# LLM_MODE=live
# LLM_API_KEY=sk-...                    # OpenAI-compatible API key
# LLM_API_BASE_URL=https://api.openai.com
#
# ─── Optional: record mode (project maintainer refreshing the cassette) ──
# LLM_MODE=record
# LLM_API_KEY=sk-...
# LLM_API_BASE_URL=https://api.openai.com

# ─── Supabase (frontend) — publishable values, safe to commit ────────────
VITE_SUPABASE_URL=https://yyqbxzcjnpsijkjbfjcg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=yyqbxzcjnpsijkjbfjcg

# ─── Optional: brownfield demo runner credentials ────────────────────────
# DEMO_EMAIL=reviewer@example.com
# DEMO_PASSWORD=change-me

# ─── Optional: transactional email (Supabase edge functions) ─────────────
# EMAIL_API_KEY=...
# EMAIL_API_URL=https://your-email-provider.example.com
# SITE_URL=https://your-app.example.com
